# Copy this file to .env and fill in real values ON THE SERVER ONLY.
# Never commit .env or paste real keys into chat.

DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_BASE_URL=https://api.india.delta.exchange

SYMBOL=BTCUSD
RESOLUTION=15m
EMA_PERIOD=20
TREND_CONFIRM_BARS=3
PIVOT_LOOKBACK=2

RISK_PCT=0.02
RR_TARGET=3
BREAKEVEN_TRIGGER_R=0.5
LEVERAGE=3

REVIEW_INTERVAL_SECONDS=600
POLL_INTERVAL_SECONDS=60

# true = log intended actions only, never place real orders. Keep this true
# until you've watched at least a few full signal cycles in the logs.
DRY_RUN=true

STATE_FILE=state.json
LOG_FILE=bot.log
